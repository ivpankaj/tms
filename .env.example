# ==============================================================================
# NexusCRM - Example Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your real credentials:
# cp .env.example .env
# ==============================================================================

# 1. DATABASE CONFIGURATION
MONGODB_URI=mongodb://127.0.0.1:27017/nexuscrm
MONGODB_DB_NAME=nexuscrm

# 2. AUTHENTICATION & SECURITY
JWT_SECRET=nexus_crm_super_secure_jwt_secret_change_in_production_32_chars!
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=optional_refresh_token_secret_here
SESSION_COOKIE_NAME=nexus_token
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# 3. APPLICATION CORE
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 4. TRANSACTIONAL EMAIL
EMAIL_PROVIDER=resend
EMAIL_FROM=notifications@nexus.io
RESEND_API_KEY=re_demo_123456789
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@nexus.io
SMTP_PASSWORD=demo_smtp_password
SMTP_SECURE=false

# 5. CLOUD FILE STORAGE (S3 / Local)
STORAGE_DRIVER=local
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_S3_BUCKET=nexus-crm-attachments
AWS_ENDPOINT=
AWS_S3_PUBLIC_URL=

# 6. REAL-TIME WEBSOCKET
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000
SOCKET_PORT=3001

# 7. WEBHOOKS & API SECURITY
WEBHOOK_SECRET=whsec_demo_signature_secret
INTERNAL_API_KEY=nexus_internal_worker_key_sample

# 8. STRIPE BILLING
STRIPE_SECRET_KEY=sk_test_demo1234567890abcdef
STRIPE_WEBHOOK_SECRET=whsec_stripe_test_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_demo1234567890abcdef

# 9. LOGGING
LOG_LEVEL=info
SENTRY_DSN=
